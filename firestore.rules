rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{doc} { allow read, write: if request.auth != null; }
    match /reservations/{doc} { allow read, write: if request.auth != null; }
    match /feedbacks/{doc} { allow create: if request.auth != null; allow read, update, delete: if false; }
    match /notifications/{doc} { allow read, write: if request.auth != null; }
    match /employees/{doc} { allow read, write: if request.auth != null; }
    match /resourceMasters/{doc} { allow read, write: if request.auth != null; }
    match /eventCategories/{doc} { allow read, write: if request.auth != null; }
    match /{document=**} { allow read, write: if false; }
  }
}